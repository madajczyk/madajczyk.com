{{- $pages := where .Site.RegularPages "Type" "not in" (slice "page" "json") -}}
{{- $uniquePages := slice -}}
{{- $seen := dict -}}
{{- range $pages -}}
  {{- if not (index $seen .Permalink) -}}
    {{- /* Consumers render these with textContent, so emit true plain text (tags stripped, entities decoded). */ -}}
    {{- $uniquePages = $uniquePages | append (dict "title" (.Title | plainify | htmlUnescape) "date" .Date.Local "permalink" .Permalink "content" (.Plain | htmlUnescape) "summary" (.Summary | plainify | htmlUnescape) "tags" .Params.tags "image" .Params.featured_image) -}}
    {{- $seen = merge $seen (dict .Permalink true) -}}
  {{- end -}}
{{- end -}}
{{- $uniquePages | jsonify -}}